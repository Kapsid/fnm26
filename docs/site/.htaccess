# Football Nations Manager, Apache, uploaded by FTP.
#
# This replaces the Caddyfile the site carried while it was going to Railway.
# Everything here is optional: a host that ignores .htaccess still serves the
# site correctly, it just serves it without the caching and the error page.
#
# NOTE: .htaccess is a dotfile and most FTP clients hide dotfiles by default.
# If the 404 page or the caching is not working, check the file actually
# reached the server before changing anything in it.

# The error page. Root-relative, so this is right when the site sits at the
# domain root. In a subfolder it needs that prefix: /fnm/404.html.
ErrorDocument 404 /404.html

# The font and the artwork never change without changing name, so they can be
# held a long time. The pages themselves are edited, so they are not.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2  "access plus 30 days"
  ExpiresByType image/png   "access plus 30 days"
  ExpiresByType image/jpeg  "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css    "access plus 1 hour"
  ExpiresByType text/html   "access plus 5 minutes"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Older Apache builds do not know woff2 and hand it back as text, which makes
# the browser refuse the font and quietly fall back to a system face.
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>
