# Serving the site on Railway.
#
# Railway terminates TLS at its edge and injects the port to listen on, so
# Caddy's automatic HTTPS is off on purpose: switched on it would try to get
# its own certificate, for a hostname it is not reachable at, and fail.
{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# The font and the artwork never change without changing name, so they can
	# be held a long time. The pages themselves are edited, so they are not.
	#
	# The three matchers are deliberately non-overlapping, and the last one is
	# written as a negation rather than as *.html: the root path is "/", not
	# "/index.html", so a suffix matcher misses the one page most people ask
	# for and it silently ships with no cache header at all.
	@immutable path *.woff2 *.png *.svg *.jpg
	@styles path *.css
	@pages not path *.woff2 *.png *.svg *.jpg *.css
	header @immutable Cache-Control "public, max-age=2592000"
	header @styles Cache-Control "public, max-age=3600"
	header @pages Cache-Control "public, max-age=300"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}

	file_server
}
