<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and later: the same rules as backup_rules.xml, for the cloud
  backup and for moving to a new phone. See that file for why each is left out.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_flutter/fnm.sqlite.previous" />
        <exclude domain="root" path="app_flutter/fnm.sqlite-shm" />
        <exclude domain="file" path="diagnostics.log" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_flutter/fnm.sqlite.previous" />
        <exclude domain="root" path="app_flutter/fnm.sqlite-shm" />
        <exclude domain="file" path="diagnostics.log" />
    </device-transfer>
</data-extraction-rules>
