#!/bin/bash
# Serialise flutter test across agents: one flutter test process at a time.
L=/private/tmp/claude-501/-Users-martinurbanczyk-Documents-Work-fnm26/6c95b6fb-6898-4eef-9a2a-c9c308e15f0f/scratchpad/flutter.lock
until mkdir "$L" 2>/dev/null; do sleep 5; done
trap 'rmdir "$L"' EXIT
cd /Users/martinurbanczyk/Documents/Work/fnm26 && flutter test "$@"
