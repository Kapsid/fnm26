  "pressProbeAccountability1": "You've backed them again. Is nobody in that dressing room accountable?",
  "@pressProbeAccountability1": {
    "description": "Press conference: a Accountability follow-up question."
  },
  "pressProbeAccountability2": "That's the players defended. Who actually answers for a night like that?",
  "@pressProbeAccountability2": {
    "description": "Press conference: a Accountability follow-up question."
  },
  "pressProbeAccountability3": "Loyalty is easy from up there. Does anyone pay a price?",
  "@pressProbeAccountability3": {
    "description": "Press conference: a Accountability follow-up question."
  },
  "pressProbeAccountability4": "If it's never the players, we're left with one name. Yours.",
  "@pressProbeAccountability4": {
    "description": "Press conference: a Accountability follow-up question."
  },
  "pressProbeYourFuture1": "You've taken it on yourself. Should we be asking about your future?",
  "@pressProbeYourFuture1": {
    "description": "Press conference: a YourFuture follow-up question."
  },
  "pressProbeYourFuture2": "Falling on your sword is noble. Is the job still yours?",
  "@pressProbeYourFuture2": {
    "description": "Press conference: a YourFuture follow-up question."
  },
  "pressProbeYourFuture3": "You keep saying it's you. At what point is that a resignation?",
  "@pressProbeYourFuture3": {
    "description": "Press conference: a YourFuture follow-up question."
  },
  "pressProbeYourFuture4": "The board are listening too. Are you sure you want that on record?",
  "@pressProbeYourFuture4": {
    "description": "Press conference: a YourFuture follow-up question."
  },
  "pressProbeDressingRoom1": "Strong words in public. Have you lost that dressing room?",
  "@pressProbeDressingRoom1": {
    "description": "Press conference: a DressingRoom follow-up question."
  },
  "pressProbeDressingRoom2": "You've just told the country they're not good enough. How does that help?",
  "@pressProbeDressingRoom2": {
    "description": "Press conference: a DressingRoom follow-up question."
  },
  "pressProbeDressingRoom3": "Demanding it here rather than in there. Is that leadership?",
  "@pressProbeDressingRoom3": {
    "description": "Press conference: a DressingRoom follow-up question."
  },
  "pressProbeDressingRoom4": "Players read this too. What do they hear tomorrow morning?",
  "@pressProbeDressingRoom4": {
    "description": "Press conference: a DressingRoom follow-up question."
  },
  "pressProbeExpectation1": "You've raised the bar in public. Is that not a hostage to fortune?",
  "@pressProbeExpectation1": {
    "description": "Press conference: a Expectation follow-up question."
  },
  "pressProbeExpectation2": "Big promise. What happens the day you don't deliver it?",
  "@pressProbeExpectation2": {
    "description": "Press conference: a Expectation follow-up question."
  },
  "pressProbeExpectation3": "Every manager before you said the same and packed a bag. Why are you different?",
  "@pressProbeExpectation3": {
    "description": "Press conference: a Expectation follow-up question."
  },
  "pressProbeExpectation4": "You've set the target. Will you resign if you miss it?",
  "@pressProbeExpectation4": {
    "description": "Press conference: a Expectation follow-up question."
  },
  "pressProbeSubstance1": "With respect, that's not an answer. Give us something.",
